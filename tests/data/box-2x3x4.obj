# A 2 x 3 x 4 mm box, written by hand for tests/mesh_measures.cpp.
# Outward counter-clockwise winding. The top face is a separate group and refers to its
# vertices with negative (relative) indices.
v 0 0 0
v 2 0 0
v 2 3 0
v 0 3 0
v 0 0 4
v 2 0 4
v 2 3 4
v 0 3 4
o bottom_and_sides
# bottom (z = 0), normal -z
f 1 3 2
f 1 4 3
# front (y = 0), normal -y
f 1 2 6
f 1 6 5
# right (x = 2), normal +x
f 2 3 7
f 2 7 6
# back (y = 3), normal +y
f 3 4 8
f 3 8 7
# left (x = 0), normal -x
f 4 1 5
f 4 5 8
o top
# top (z = 4), normal +z: vertices 5, 6, 7, 8 are -4, -3, -2, -1
f -4 -3 -2
f -4 -2 -1
